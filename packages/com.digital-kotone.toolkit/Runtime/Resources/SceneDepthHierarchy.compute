#pragma kernel ReduceMinDepth

Texture2D<float> _DepthInput;
RWTexture2D<float> _DepthOutput;
float4 _DepthSize; // Input xy, output zw. Explicit ceil-sized levels.

[numthreads(8, 8, 1)]
void ReduceMinDepth(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)_DepthSize.zw)) return;
    int2 first = (int2)id.xy * 2;
    float closest = 3.402823466e+38;
    [unroll] for (int y = 0; y < 2; y++)
    [unroll] for (int x = 0; x < 2; x++)
    {
        int2 pixel = min(first + int2(x, y), (int2)_DepthSize.xy - 1);
        closest = min(closest, _DepthInput.Load(int3(pixel, 0)));
    }
    _DepthOutput[id.xy] = closest;
}
